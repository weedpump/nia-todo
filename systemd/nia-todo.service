[Unit]
Description=nia-todo FastAPI Server
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/nia-todo
EnvironmentFile=-/etc/nia-todo/nia-todo.env
ExecStart=/opt/nia-todo/start.sh
Restart=always
RestartSec=5
User=nia-todo
Group=nia-todo
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/nia-todo /var/cache/nia-todo

[Install]
WantedBy=multi-user.target
